    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^6.3.0"
  }
}
