  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-core.mjs && vite --host 0.0.0.0",
    "build": "node scripts/copy-core.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
